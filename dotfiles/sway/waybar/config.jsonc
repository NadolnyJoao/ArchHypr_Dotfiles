{
  "layer": "top",
  "position": "top",
  "height": 32,
  "reload_style_on_change": true,
  "modules-left": [
    "sway/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "bluetooth",
    "battery",
    "tray",
    "custom/notifications",
    "custom/power"
  ],
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%d/%m/%y}"
  },
  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": " 0%",
    "on-click": "pavucontrol",
    "on-scroll-up": "swayosd-client --output-volume raise --max-volume 100 || wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "swayosd-client --output-volume lower || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "network": {
    "format-wifi": "   {essid}",
    "format-ethernet": "󰈀",
    "format-disconnected": "sem rede",
    "on-click": "kitty --title 'Redes Wi-Fi' -e nmtui-connect"
  },
  "bluetooth": {
    "format": "  ",
    "format-no-controller": "",
    "tooltip-format": " Bluetooth",
    "tooltip-format-off": " Bluetooth desligado",
    "tooltip-format-disabled": " Bluetooth desativado",
    "tooltip-format-on": " Bluetooth ligado",
    "tooltip-format-connected": " Dispositivos conectados\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "blueman-manager"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "tray": {
    "ignore-list": [
      "nm-applet",
      "blueman"
    ]
  },
  "custom/notifications": {
    "exec": "swaync-client --subscribe-waybar",
    "return-type": "json",
    "format": " {}",
    "on-click": "swaync-client --toggle-panel",
    "escape": true
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "bash \"${XDG_CONFIG_HOME:-$HOME/.config}/sway/scripts/action.sh\" power"
  },
  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  }
}
