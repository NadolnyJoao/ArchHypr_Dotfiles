{
  "layer": "top",
  "position": "top",
  "height": 32,
  "reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "tray", "custom/notifications", "custom/power"],
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%d/%m/%y}"
  },
  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "mudo",
    "on-click": "pavucontrol",
    "on-scroll-up": "swayosd-client --output-volume raise --max-volume 100 || wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "swayosd-client --output-volume lower || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },
  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀",
    "format-disconnected": "sem rede",
    "on-click": "systemctl is-active --quiet NetworkManager && nm-connection-editor"
  },
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },
  "custom/notifications": {
    "exec": "swaync-client --subscribe-waybar",
    "return-type": "json",
    "format": " {}",
    "on-click": "swaync-client --toggle-panel",
    "escape": true
  },
  "custom/power": {
    "format": "⏻",
    "on-click": "bash \"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/power-menu.sh\""
  }
}
