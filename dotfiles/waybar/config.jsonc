{
  "layer": "top",
  "position": "top",
  "height": 32,
  "reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "battery", "tray", "custom/notifications", "custom/power"],
  "clock": {"format": "{:%H:%M}", "tooltip-format": "{:%d/%m/%Y}"},
  "pulseaudio": {"format": "VOL {volume}%", "format-muted": "MUDO", "on-click": "pavucontrol"},
  "network": {"format-wifi": "{essid}", "format-ethernet": "Cabo", "format-disconnected": "Sem rede", "on-click": "systemctl is-active --quiet NetworkManager && nm-connection-editor"},
  "battery": {"format": "BAT {capacity}%", "format-charging": "AC {capacity}%"},
  "custom/notifications": {
    "exec": "swaync-client --subscribe-waybar",
    "return-type": "json",
    "format": " {}",
    "on-click": "swaync-client --toggle-panel",
    "escape": true
  },
  "custom/power": {"format": "⏻", "on-click": "bash \"${XDG_CONFIG_HOME:-$HOME/.config}/hypr/scripts/power-menu.sh\""}
}
