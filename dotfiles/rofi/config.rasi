configuration {
    show-icons: true;
    display-drun: "Aplicativos";
    font: "JetBrainsMono Nerd Font 12";
}
@import "colors.rasi"

window {
    location: center;
    width: 520px;
    background-color: @base;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
}
mainbox { padding: 14px; spacing: 10px; }
inputbar { children: [prompt, entry]; spacing: 10px; }
listview { lines: 7; spacing: 4px; }
element { padding: 8px; spacing: 8px; }
element selected { background-color: @accent; text-color: @base; }
element-text { text-color: inherit; background-color: inherit; }
element-icon { size: 24px; background-color: inherit; }
