configuration {
    show-icons: true;
    display-drun: "Aplicativos";
    font: "JetBrainsMono Nerd Font 12";
}

@import "colors.rasi"

window {
    location: center;
    width: 44%;
    transparency: "real";
    background-color: @panel;
    border: 1px;
    border-color: @accent;
    border-radius: 16px;
}

mainbox {
    children: [ inputbar, message, listview ];
    padding: 16px;
    spacing: 12px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 12px;
    padding: 9px 12px;
    border: 1px;
    border-color: @accent;
    border-radius: 10px;
}

prompt {
    text-color: @accent;
    vertical-align: 0.5;
}

entry {
    placeholder: "Buscar…";
    placeholder-color: @text;
    vertical-align: 0.5;
}

message {
    padding: 0px 10px;
}

listview {
    lines: 7;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 4px;
}

element {
    children: [ element-icon, element-text ];
    padding: 8px 10px;
    spacing: 10px;
    border-radius: 9px;
    text-color: @text;
}

element normal normal,
element alternate normal {
    background-color: transparent;
    text-color: @text;
}

element selected {
    background-color: @accent;
    text-color: @base;
}

element-icon {
    size: 20px;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    text-color: inherit;
    background-color: transparent;
    vertical-align: 0.5;
}
